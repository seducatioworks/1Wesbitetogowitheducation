# Spectre Tutors Network - Environment Variables

# Supabase Cloud Database (Optional - falls back to local storage if unconfigured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Spectre Coordinator WhatsApp (For direct click-to-chat links, digits only with country code, e.g. 919812345678)
VITE_COORDINATOR_WHATSAPP=919812345678

# CallMeBot Automated Alerts (Free automated background WhatsApp alerts to your phone)
# 1. Message "I allow callmebot to send me messages" to +34 644 68 81 74 on WhatsApp
# 2. Paste your phone and the API key sent back to you:
VITE_CALLMEBOT_PHONE=+919812345678
VITE_CALLMEBOT_APIKEY=your_callmebot_api_key
