# Spectre Tutors Network - Environment Variables

# Spectre Business WhatsApp Number (Direct Click-to-Chat)
# Format: International digits only without '+', spaces, or hyphens (e.g. 919812345678)
VITE_SPECTRE_WHATSAPP_NUMBER=919876543210

# Supabase Cloud Database (Optional - falls back to local storage if unconfigured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
